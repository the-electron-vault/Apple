				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4ca78b45-dbba-4377-a6b9-1948b51d7e51")
	)
	(text_box "DESIGN NOTE:\nVoltage sensing (VS1, VS2) is not implemented by the host.\n\nWE_L should be tied to VCC by the host.\n\nCSEL_L Low = Master\n\nThe CompactFlash specification marks pins 43 and 44 as Reserved for Future Use (RFU), however other sources show these pins connected to DMARQ and DMACK, respectively.\n\nDASP_L and PDIAG_L are not connected on iPod."
		(exclude_from_sim no)
		(at 259.08 116.84 0)
		(size 30.48 45.72)
		(stroke
			(width -0.0001)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
