	(text_box "DESIGN NOTE:\nIOCS16_L is grounded on the iPod flex (632-0259)."
		(exclude_from_sim no)
		(at 190.5 162.56 0)
		(size 27.94 7.62)
		(stroke
			(width -0.0001)
			(type solid)
